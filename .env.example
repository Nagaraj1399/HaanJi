# GEMINI_API_KEY: AI Studio Secrets panel or https://aistudio.google.com/apikey (optional Gemini live AI fallback)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed app (Cloud Run / Vercel / local http://localhost:3000)
APP_URL="MY_APP_URL"

# SARVAM_API_KEY: Sarvam AI Dashboard -> API Keys (https://dashboard.sarvam.ai) for saaras:v4 STT, sarvam-105b Chat, bulbul:v4-flash TTS, mayura:v1 Translate
SARVAM_API_KEY=""

# FLAGSMITH_ENV_KEY: Flagsmith Project -> Environments -> API Keys -> Server-side / Environment Key (https://app.flagsmith.com)
FLAGSMITH_ENV_KEY=""

# FLAGSMITH_SERVER_KEY: Optional alias for FLAGSMITH_ENV_KEY used by Flagsmith server SDK
FLAGSMITH_SERVER_KEY=""

# FLAGSMITH_ADMIN_KEY: Flagsmith Organisation Settings -> API Keys (required for automated /ops/degrade writes back to Flagsmith)
FLAGSMITH_ADMIN_KEY=""

# FLAGSMITH_ENV_ID: Flagsmith Environment numeric/string ID for Admin API PATCH endpoint
FLAGSMITH_ENV_ID=""

# NUDGEBEE_EVENT_WEBHOOK_URL: NudgeBee Cloud -> Integrations -> Event Webhook URL for incident alerts
NUDGEBEE_EVENT_WEBHOOK_URL=""

# NUDGEBEE_API_TOKEN: NudgeBee Cloud -> Settings -> API Tokens for authenticated status checks
NUDGEBEE_API_TOKEN=""

# HAANJI_HOST_KEY: Random secret token protecting /api/host/* routes (generated randomly on startup if unset)
HAANJI_HOST_KEY=""

# HAANJI_OPS_TOKEN: Random secret token protecting /ops/* X-Ops-Token routes (generated randomly on startup if unset)
HAANJI_OPS_TOKEN=""
